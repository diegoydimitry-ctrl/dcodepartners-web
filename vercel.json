{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/como-funciona",
      "destination": "/que-hacemos",
      "permanent": true
    },
    {
      "source": "/en/como-funciona",
      "destination": "/en/que-hacemos",
      "permanent": true
    },
    {
      "source": "/servicios",
      "destination": "/que-hacemos",
      "permanent": true
    },
    {
      "source": "/en/servicios",
      "destination": "/en/que-hacemos",
      "permanent": true
    },
    {
      "source": "/departamentos",
      "destination": "/que-hacemos",
      "permanent": true
    },
    {
      "source": "/en/departamentos",
      "destination": "/en/que-hacemos",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(fonts|logo)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*).(png|ico|svg|webp)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/assets/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}